# Database Connection (Supabase / Postgres)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase Credentials
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"

# Flutterwave Credentials
FLW_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X"
FLW_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X"
FLW_ENCRYPTION_KEY="your_encryption_key_here"
FLW_WEBHOOK_SECRET_HASH="your_webhook_secret_hash_here"

# Flutterwave Payment Plan IDs (created in Flutterwave Dashboard -> Payment Plans)
FLW_MONTHLY_PLAN_ID="167422"
FLW_ANNUAL_PLAN_ID="167424"

# Vercel Cron Secret (protects /api/cron-charge-trials)
CRON_SECRET="your_cron_secret_here"

# IP Hash Salt (protects /api/check-free-usage)
IP_HASH_SALT="your_ip_hash_salt_here"
